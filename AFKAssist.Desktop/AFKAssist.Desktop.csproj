<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>AFKAssist.Desktop</RootNamespace>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>embedded</DebugType>
        <Description>Keeps A Game Active While You Are Away By Simulating Keyboard And Mouse Input</Description>
        <Copyright>Copyright 2026</Copyright>
        <Version>1.8</Version>
        <AssemblyTitle>AFK Assist</AssemblyTitle>
        <Product>AFK Assist</Product>
        <Company>poolfullofmilk</Company>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <NoWarn>WFO0003</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AssemblyName>AFKAssist_v$(Version)</AssemblyName>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>
    <Target
        Name="BundleWebRoot"
        BeforeTargets="_ComputeFilesToBundle"
        DependsOnTargets="CopyStaticWebAssetsToPublishDirectory"
    >
        <ItemGroup>
            <WebRootFile Include="$(PublishDir)wwwroot\**" />
            <ResolvedFileToPublish
                Include="@(WebRootFile)"
                RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
            />
        </ItemGroup>
    </Target>
    <Target Name="RemoveLooseWebRoot" AfterTargets="Publish">
        <RemoveDir Directories="$(PublishDir)wwwroot" />
        <Delete Files="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
    </Target>
    <Target
        Name="AddCommitMetadata"
        AfterTargets="InitializeSourceControlInformation"
        Condition="'$(SourceRevisionId)' != ''"
    >
        <ItemGroup>
            <AssemblyMetadata Include="Commit" Value="$(SourceRevisionId)" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <Using Remove="System.Drawing" />
        <Using Remove="System.Windows.Forms" />
        <Using Include="System.IO" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference
            Include="Microsoft.AspNetCore.Components.WebView.Wpf"
            Version="10.0.120"
        />
        <PackageReference Include="MudBlazor" Version="9.11.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AFKAssist.Data\AFKAssist.Data.csproj" />
        <ProjectReference Include="..\AFKAssist.Services\AFKAssist.Services.csproj" />
    </ItemGroup>
</Project>

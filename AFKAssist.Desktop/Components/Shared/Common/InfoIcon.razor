@* Info Icon *@
<Tooltip Text="@Text"
         RootClass="d-inline-flex ml-1 cursor-default info-icon">
    <MudIcon Icon="@(Warning ? Icons.Material.Rounded.Warning : Icons.Material.Rounded.Info)"
             Color="@(Warning ? Color.Warning : Color.Inherit)"
             Style="@IconStyle"
             Size="Size.Small" />
</Tooltip>

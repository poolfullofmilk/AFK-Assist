<Window
    x:Class="AFKAssist.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
    xmlns:components="clr-namespace:AFKAssist.Desktop.Components"
    xmlns:helpers="clr-namespace:AFKAssist.Data.Helpers;assembly=AFKAssist.Data"
    Title="{x:Static helpers:AppInfo.DisplayName}"
    Width="1200"
    Height="760"
    Background="#202020"
    ResizeMode="CanMinimize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
>
    <!-- BlazorWebView -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Home}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>

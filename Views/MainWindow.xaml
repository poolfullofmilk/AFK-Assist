<ui:FluentWindow x:Class="AFK_Assist.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewmodels="clr-namespace:AFK_Assist.ViewModels"
                 xmlns:views="clr-namespace:AFK_Assist.Views"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
                 mc:Ignorable="d"
                 Title="AFK Assist"
                 Width="840"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ResizeMode="CanMinimize"
                 SizeToContent="Height"
                 Topmost="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Resources>
            <Style x:Key="ChipButton"
                   TargetType="ui:Button"
                   BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin"
                        Value="4,0,0,0" />
                <Setter Property="Padding"
                        Value="8,2" />
                <Setter Property="FontSize"
                        Value="11" />
            </Style>
            <Style TargetType="ui:NumberBox"
                   BasedOn="{StaticResource {x:Type ui:NumberBox}}">
                <Setter Property="ClearButtonEnabled"
                        Value="False" />
                <Setter Property="MaxDecimalPlaces"
                        Value="0" />
                <Setter Property="Minimum"
                        Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="AFK Assist"
                     CanMaximize="False"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Icon.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button Margin="0,0,8,0"
                           AutomationProperties.Name="Check For Updates"
                           Appearance="Transparent"
                           Command="{Binding CheckForUpdatesCommand}"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           ToolTip="Check For Updates" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- InfoBar -->
        <ui:InfoBar x:Name="NoticeBar"
                    Grid.Row="1"
                    Margin="16,0,16,12"
                    IsClosable="False"
                    IsOpen="{Binding HasNotice, Mode=OneWay}"
                    Message="{Binding NoticeMessage}"
                    Severity="{Binding NoticeSeverity}" />

        <Grid Grid.Row="2"
              Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Input Card -->
            <ui:Card Grid.Row="0"
                     Grid.Column="0"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     IsEnabled="{Binding CanEditConfiguration}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Top">
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Text="Mouse" />
                        <CheckBox Margin="0,10,0,0"
                                  Content="Left Click"
                                  IsChecked="{Binding MouseLeftClickEnabled}" />
                        <CheckBox Content="Right Click"
                                  IsChecked="{Binding MouseRightClickEnabled}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top">
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Text="Keyboard" />
                        <CheckBox Margin="0,10,0,0"
                                  Content="{Binding ForwardKeyLabel}"
                                  IsChecked="{Binding ForwardKeyEnabled}" />
                        <CheckBox Content="{Binding LeftKeyLabel}"
                                  IsChecked="{Binding LeftKeyEnabled}" />
                        <CheckBox Content="{Binding BackwardKeyLabel}"
                                  IsChecked="{Binding BackwardKeyEnabled}" />
                        <CheckBox Content="{Binding RightKeyLabel}"
                                  IsChecked="{Binding RightKeyEnabled}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding CustomKeyEnabled}"
                                      IsEnabled="{Binding HasCustomKey}">
                                <TextBlock Text="{Binding CustomKeyLabel}"
                                           TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                            <ui:Button x:Name="CustomKeyButton"
                                       Grid.Column="1"
                                       MinWidth="64"
                                       Command="{Binding CaptureCustomKeyCommand}"
                                       Content="{Binding CustomKeyButtonLabel}"
                                       PreviewKeyDown="CaptureCustomKey"
                                       Style="{StaticResource ChipButton}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ScrollViewer -->
            <ScrollViewer Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding CanEditConfiguration}">

                    <!-- Speed Card -->
                    <ui:Card>
                        <StackPanel>
                            <Grid>
                                <ui:TextBlock FontTypography="BodyStrong"
                                              Text="Speed" />
                                <ui:TextBlock HorizontalAlignment="Right"
                                              Appearance="Secondary"
                                              Text="{Binding SpeedLabel}" />
                            </Grid>
                            <Slider Margin="0,8,0,0"
                                    AutomationProperties.Name="Speed"
                                    IsSnapToTickEnabled="True"
                                    Maximum="{x:Static viewmodels:MainViewModel.MaximumSpeed}"
                                    Minimum="{x:Static viewmodels:MainViewModel.MinimumSpeed}"
                                    TickFrequency="1"
                                    TickPlacement="BottomRight"
                                    Value="{Binding SimulationsPerMinute}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Start Delay Card -->
                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <ui:TextBlock VerticalAlignment="Center"
                                              FontTypography="BodyStrong"
                                              Text="Start Delay" />
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <ui:Button Appearance="{Binding StartDelayTotalSeconds, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=5}"
                                               Command="{Binding ApplyStartDelayPresetCommand}"
                                               CommandParameter="5"
                                               Content="5s"
                                               Style="{StaticResource ChipButton}" />
                                    <ui:Button Appearance="{Binding StartDelayTotalSeconds, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=10}"
                                               Command="{Binding ApplyStartDelayPresetCommand}"
                                               CommandParameter="10"
                                               Content="10s"
                                               Style="{StaticResource ChipButton}" />
                                    <ui:Button Appearance="{Binding StartDelayTotalSeconds, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=30}"
                                               Command="{Binding ApplyStartDelayPresetCommand}"
                                               CommandParameter="30"
                                               Content="30s"
                                               Style="{StaticResource ChipButton}" />
                                    <ui:Button Appearance="{Binding StartDelayTotalSeconds, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=60}"
                                               Command="{Binding ApplyStartDelayPresetCommand}"
                                               CommandParameter="60"
                                               Content="1m"
                                               Style="{StaticResource ChipButton}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:NumberBox AutomationProperties.Name="Start Delay Minutes"
                                                  Maximum="{x:Static viewmodels:MainViewModel.MaximumMinutes}"
                                                  Value="{Binding StartDelayMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:TextBlock Margin="0,6,0,0"
                                                  Appearance="Tertiary"
                                                  FontTypography="Caption"
                                                  Text="Minutes" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:NumberBox AutomationProperties.Name="Start Delay Seconds"
                                                  Maximum="{x:Static viewmodels:MainViewModel.MaximumSeconds}"
                                                  Value="{Binding StartDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:TextBlock Margin="0,6,0,0"
                                                  Appearance="Tertiary"
                                                  FontTypography="Caption"
                                                  Text="Seconds" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Duration Card -->
                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <ui:TextBlock VerticalAlignment="Center"
                                              FontTypography="BodyStrong"
                                              Text="Duration" />
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <ui:Button Appearance="{Binding DurationTotalMinutes, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=15}"
                                               Command="{Binding ApplyDurationPresetCommand}"
                                               CommandParameter="15"
                                               Content="15m"
                                               Style="{StaticResource ChipButton}" />
                                    <ui:Button Appearance="{Binding DurationTotalMinutes, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=30}"
                                               Command="{Binding ApplyDurationPresetCommand}"
                                               CommandParameter="30"
                                               Content="30m"
                                               Style="{StaticResource ChipButton}" />
                                    <ui:Button Appearance="{Binding DurationTotalMinutes, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=60}"
                                               Command="{Binding ApplyDurationPresetCommand}"
                                               CommandParameter="60"
                                               Content="1h"
                                               Style="{StaticResource ChipButton}" />
                                    <ui:Button Appearance="{Binding DurationTotalMinutes, Converter={x:Static views:PresetAppearanceConverter.Instance}, ConverterParameter=480}"
                                               Command="{Binding ApplyDurationPresetCommand}"
                                               CommandParameter="480"
                                               Content="8h"
                                               Style="{StaticResource ChipButton}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:NumberBox AutomationProperties.Name="Duration Hours"
                                                  Maximum="{Binding HoursMaximum}"
                                                  Value="{Binding DurationHours, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:TextBlock Margin="0,6,0,0"
                                                  Appearance="Tertiary"
                                                  FontTypography="Caption"
                                                  Text="Hours" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:NumberBox AutomationProperties.Name="Duration Minutes"
                                                  Maximum="{x:Static viewmodels:MainViewModel.MaximumMinutes}"
                                                  Value="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:TextBlock Margin="0,6,0,0"
                                                  Appearance="Tertiary"
                                                  FontTypography="Caption"
                                                  Text="Minutes" />
                                </StackPanel>
                            </Grid>

                            <!-- Run Mode ToggleSwitch -->
                            <StackPanel Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                <ui:TextBlock VerticalAlignment="Center"
                                              Text="Run For" />
                                <ui:ToggleSwitch Margin="12,0,12,0"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Run Until"
                                                 IsChecked="{Binding RunUntilEnabled}" />
                                <ui:TextBlock VerticalAlignment="Center"
                                              Text="Run Until" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- Time Card -->
            <ui:Card Grid.Row="2"
                     Grid.Column="0"
                     Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel HorizontalAlignment="Left">
                            <ui:TextBlock Appearance="Tertiary"
                                          FontTypography="Caption"
                                          Text="Elapsed" />
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="{Binding ElapsedLabel}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <ui:TextBlock HorizontalAlignment="Right"
                                          Appearance="Tertiary"
                                          FontTypography="Caption"
                                          Text="Remaining" />
                            <ui:TextBlock HorizontalAlignment="Right"
                                          FontTypography="BodyStrong"
                                          Text="{Binding RemainingLabel}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Height="4"
                                 Margin="0,12,0,0"
                                 Value="{Binding ProgressPercentage}" />
                </StackPanel>
            </ui:Card>

            <!-- Action Buttons -->
            <Grid Grid.Row="3"
                  Grid.Column="0"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Height="36"
                           HorizontalAlignment="Stretch"
                           Appearance="Primary"
                           Command="{Binding StartOrPauseCommand}"
                           Content="{Binding StartButtonLabel}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding StartButtonSymbol}" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Grid.Column="2"
                           Height="36"
                           HorizontalAlignment="Stretch"
                           Command="{Binding StopCommand}"
                           Content="Stop"
                           Icon="{ui:SymbolIcon Stop24}" />
            </Grid>

            <!-- Options Card -->
            <ui:Card Grid.Row="0"
                     Grid.Column="2"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch"
                     IsEnabled="{Binding CanEditConfiguration}">
                <StackPanel VerticalAlignment="Top">
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Text="Options" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:ToggleSwitch Grid.Column="0"
                                         VerticalAlignment="Center"
                                         Content="Switch To Game"
                                         IsChecked="{Binding SwitchToGameEnabled}" />
                        <ComboBox Grid.Column="1"
                                  Width="190"
                                  Height="26"
                                  Padding="10,0"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Game"
                                  DisplayMemberPath="Value"
                                  IsEnabled="{Binding SwitchToGameEnabled}"
                                  ItemsSource="{Binding AvailableGames}"
                                  SelectedValue="{Binding SelectedGameKey}"
                                  SelectedValuePath="Key" />
                    </Grid>
                    <ui:ToggleSwitch Margin="0,8,0,0"
                                     Content="Randomize Simulation"
                                     IsChecked="{Binding RandomizeSimulationEnabled}" />
                    <ui:ToggleSwitch Margin="0,8,0,0"
                                     Content="Randomize Intervals"
                                     IsChecked="{Binding RandomizeIntervalsEnabled}" />
                    <ui:ToggleSwitch Margin="0,8,0,0"
                                     Content="Hold Keys Longer"
                                     IsChecked="{Binding HoldKeysEnabled}" />
                    <ui:ToggleSwitch Margin="0,8,0,0"
                                     Content="Move Mouse Naturally"
                                     IsChecked="{Binding MouseMovementEnabled}" />
                </StackPanel>
            </ui:Card>

            <!-- Activity Card -->
            <ui:Card Grid.Row="1"
                     Grid.RowSpan="3"
                     Grid.Column="2"
                     Margin="0,12,0,0"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <ui:TextBlock VerticalAlignment="Center"
                                      FontTypography="BodyStrong"
                                      Text="Activity" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <ui:Button Command="{Binding OpenLogFolderCommand}"
                                       Content="Open Folder"
                                       Style="{StaticResource ChipButton}" />
                            <ui:Button Command="{Binding ClearLogFilesCommand}"
                                       Content="Clear Log Files"
                                       Style="{StaticResource ChipButton}" />
                        </StackPanel>
                    </Grid>

                    <!-- Log ScrollViewer -->
                    <ScrollViewer x:Name="LogScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl FontFamily="Cascadia Mono, Consolas, Courier New"
                                      FontSize="12"
                                      ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                                   Text="{Binding Time}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Message}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}"
                                                                     Value="Input">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}"
                                                                     Value="Success">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}"
                                                                     Value="Warning">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}"
                                                                     Value="Error">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty Activity TextBlock -->
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="No Activity Yet">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogEntries.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ui:Card>

        </Grid>
    </Grid>
</ui:FluentWindow>
